# --- Postgres ---
POSTGRES_USER=bma
POSTGRES_PASSWORD=bma
POSTGRES_DB=breakmyagent
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://bma:bma@postgres:5432/breakmyagent

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_HOST_PORT=6380

# --- API ---
API_PORT=3000
API_HOST_PORT=3100
JWT_SECRET=change-me-to-a-long-random-string
IP_HASH_SALT=change-me-too
AGENT_URL=http://agent:8000
AGENT_HOST_PORT=8100
AGENT_TIMEOUT_MS=30000
CORS_ORIGIN=http://localhost:5173

# Rate limits
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_DAY=150
RATE_LIMIT_IP_PER_MIN=30

# Global daily LLM budget (USD) + price per 1M tokens for cost estimates
DAILY_BUDGET_USD=5
PRICE_INPUT_PER_MTOK=1.0
PRICE_OUTPUT_PER_MTOK=5.0

# --- Agent service ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=claude-haiku-5-5
GUARD_MODEL=claude-haiku-5-5
CLASSIFIER_MODEL=claude-haiku-5-5

# --- Web ---
WEB_HOST_PORT=5173
VITE_API_URL=http://localhost:3100
